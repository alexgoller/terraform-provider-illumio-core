# Log files
*.log

# IDE files
.idea/
.vscode/

# Terraform files
# NOTE: do not use a bare "**/terraform.*" glob here. It matches
# vendor/**/terraform.go, which silently excluded the vendored files defining
# hc-install's simpleVersionRe and terraform-exec's Terraform type, breaking
# "go build ./..." on a fresh clone.
**/.terraform/
**/.terraform.*
**/terraform.tfstate
**/terraform.tfstate.*
**/terraform.tfvars
**/terraform.tfvars.json
**/terraform.rc

# Generated by MacOS
.DS_Store

# EXE files
**/*.exe

# CSV files
**/*.csv

# Unit test reports
TEST*.xml

# out files
**/*.out

# ignore the build directory
pkg/

# local environment config files
*.env
env.bat

# misc
TODO

# provider mirror build output
mirror/
