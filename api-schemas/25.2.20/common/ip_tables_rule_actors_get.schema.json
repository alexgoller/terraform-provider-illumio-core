{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "actors": {
        "description": "Rule Actors are all workloads ('ams')",
        "type": "string"
      },
      "label": { "$ref": "label_optional_key_value.schema.json" },
      "label_group": {
        "type": "object",
        "additionalProperties": false,
        "required": ["href"],
        "properties": {
          "href": {
            "description": "Label group URI",
            "type": "string"
          }
        }
      },
      "workload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["href"],
        "properties": {
          "href": {
            "description": "Workload URI",
            "type": "string"
          }
        }
      }
    }
  }
}