{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["href", "enabled", "statements", "actors", "ip_version"],
  "properties": {
    "href": {
      "description": "URI of object",
      "type": "string"
    },
    "created_at": {
      "description": "Timestamp when this rule set was first created",
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "description": "Timestamp when this rule set was last updated",
      "type": "string",
      "format": "date-time"
    },
    "deleted_at": {
      "description": "Timestamp when this rule set was deleted",
      "type": ["string", "null"],
      "format": "date-time"
    },
    "created_by": {
      "type": "object",
      "required": ["href"],
      "properties": {
        "href": {
          "description": "User who originally created this rule set",
          "type": "string"
        }
      }
    },
    "updated_by": {
      "type": "object",
      "required": ["href"],
      "properties": {
        "href": {
          "description": "User who last updated this rule set",
          "type": "string"
        }
      }
    },
    "deleted_by": {
      "type": ["object", "null"],
      "required": ["href"],
      "properties": {
        "href": {
          "description": "User who deleted this rule set",
          "type": "string"
        }
      }
    },
    "update_type": {
      "$ref": "../common/sec_policy_update_type.schema.json"
    },
    "enabled": {
      "description": "Enabled flag",
      "type": "boolean"
    },
    "description": {
      "description": "Description",
      "type": ["string", "null"]
    },
    "statements": {
      "description": "list of the iptables statements in this rule",
      "type": "array",
      "items": { "$ref": "../common/ip_tables_statement.schema.json" }
    },
    "actors": { "$ref": "ip_tables_rule_actors_get.schema.json" },
    "ip_version": {
      "description": "IP version for the rules to be applied to",
      "type": "string",
      "enum": ["4", "6"]
    }
  }
}
