{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "container_workload_profiles": {
      "description": "List of Container Workload Profile hrefs",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "href"
        ],
        "properties": {
          "href": {
            "description": "Container Workload Profile URI",
            "type": "string"
          }
        }
      }
    },
    "labels": {
      "description": "Labels to assign to the workload that matches the namespace",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "../common/label_restrictions.schema.json"
      }
    },
    "enforcement_mode": {
      "$ref": "../common/workload_enforcement_mode.schema.json"
    },
    "managed": {
      "description": "If the namespace is managed or not",
      "type": "boolean"
    }
  }
}
