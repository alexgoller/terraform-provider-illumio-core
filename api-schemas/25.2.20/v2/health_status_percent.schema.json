{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "status",
    "percent"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "normal",
        "warning",
        "critical"
      ]
    },
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
