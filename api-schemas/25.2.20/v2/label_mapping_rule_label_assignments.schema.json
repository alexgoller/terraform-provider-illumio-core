{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "array",
  "description": "List of label assignments for a rule",
  "items": {
    "anyOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "object",
            "properties": {
              "href": {
                "type": "string",
                "description": "HREF of the pre-existing label"
              }
            }
          }
        }
      }
    ]
  }
}
