{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "key",
    "value",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "href": {
      "description": "URI of this label",
      "type": "string"
    },
    "deleted": {
      "description": "This label has been deleted",
      "type": "boolean"
    },
    "key": {
      "description": "Key in key-value pair",
      "type": "string"
    },
    "value": {
      "description": "Value in key-value pair",
      "type": "string"
    },
    "external_data_set": {
      "description": "External data set identifier",
      "type": [
        "string",
        "null"
      ]
    },
    "external_data_reference": {
      "description": "External data reference identifier",
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "description": "Timestamp when this label was first created",
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "description": "Timestamp when this label was last updated",
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "object",
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "description": "User who originally created this label",
          "type": "string"
        }
      }
    },
    "updated_by": {
      "type": "object",
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "description": "User who last updated this label",
          "type": "string"
        }
      }
    }
  }
}
