{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Assigned labels summary",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "href"
    ],
    "properties": {
      "href": {
        "description": "Label URI",
        "type": "string"
      },
      "key": {
        "description": "Key in key-value pair",
        "type": "string"
      },
      "value": {
        "description": "Value in key-value pair",
        "type": "string"
      }
    }
  }
}
