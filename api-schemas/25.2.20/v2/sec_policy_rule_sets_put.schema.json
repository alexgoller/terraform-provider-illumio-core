{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "description": "Name (must be unique)",
      "type": "string"
    },
    "description": {
      "description": "Description",
      "type": "string"
    },
    "external_data_set": {
      "description": "External data set identifier",
      "type": [
        "string",
        "null"
      ]
    },
    "external_data_reference": {
      "description": "External data reference identifier",
      "type": [
        "string",
        "null"
      ]
    },
    "enabled": {
      "description": "Enabled flag",
      "type": "boolean"
    },
    "update_type": {
      "description": "Type of update",
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete"
      ]
    },
    "scopes": {
      "$ref": "../common/rule_set_scopes_put.schema.json"
    },
    "rules": {
      "description": "Array of rules in this rule set",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "href"
            ]
          },
          {
            "required": [
              "enabled",
              "providers",
              "consumers",
              "ingress_services",
              "resolve_labels_as"
            ]
          }
        ],
        "properties": {
          "href": {
            "description": "URI of Rule",
            "type": "string"
          },
          "enabled": {
            "description": "Enabled flag",
            "type": "boolean"
          },
          "description": {
            "description": "Description",
            "type": "string"
          },
          "external_data_set": {
            "description": "External data set identifier",
            "type": [
              "string",
              "null"
            ]
          },
          "external_data_reference": {
            "description": "External data reference identifier",
            "type": "string"
          },
          "ingress_services": {
            "$ref": "../common/sec_rule_ingress_services.schema.json"
          },
          "resolve_labels_as": {
            "$ref": "../common/sec_rule_resolve_labels_as.schema.json"
          },
          "sec_connect": {
            "description": "Whether a secure connection is established",
            "type": "boolean"
          },
          "stateless": {
            "expose_to": [
              "end_user_experimental"
            ],
            "description": "Whether packet filtering is stateless for the rule",
            "type": "boolean"
          },
          "machine_auth": {
            "expose_to": [
              "end_user_experimental"
            ],
            "description": "Whether machine authentication is enabled",
            "type": "boolean"
          },
          "providers": {
            "$ref": "sec_policy_rule_sets_sec_rules_providers_put.schema.json"
          },
          "consumers": {
            "$ref": "sec_policy_rule_sets_sec_rules_consumers_put.schema.json"
          },
          "consuming_security_principals": {
            "$ref": "../common/consuming_security_principals_put.schema.json"
          },
          "update_type": {
            "description": "Type of update",
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete"
            ]
          },
          "unscoped_consumers": {
            "description": "Set the scope for rule consumers to All",
            "type": "boolean"
          },
          "network_type": {
            "$ref": "../common/rule_network_type.schema.json",
            "expose_to": [
              "end_user_experimental"
            ]
          },
          "use_workload_subnets": {
            "$ref": "../common/sec_rule_use_workload_subnets.schema.json"
          }
        }
      }
    },
    "ip_tables_rules": {
      "description": "Array of iptables rules in this ruleset",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "href"
            ]
          },
          {
            "required": [
              "enabled",
              "statements",
              "actors",
              "ip_version"
            ]
          }
        ],
        "properties": {
          "href": {
            "description": "URI of Rule",
            "type": "string"
          },
          "enabled": {
            "description": "Enabled flag",
            "type": "boolean"
          },
          "description": {
            "description": "Description",
            "type": "string"
          },
          "statements": {
            "description": "list of the iptables statements in this rule",
            "type": "array",
            "items": {
              "$ref": "../common/ip_tables_statement.schema.json"
            }
          },
          "actors": {
            "$ref": "../common/ip_tables_rule_actors_put.schema.json"
          },
          "ip_version": {
            "description": "IP version for the rules to be applied to",
            "type": "string",
            "enum": [
              "4",
              "6"
            ]
          },
          "update_type": {
            "description": "Type of update",
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete"
            ]
          }
        }
      }
    }
  }
}
