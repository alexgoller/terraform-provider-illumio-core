{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sid",
    "name"
  ],
  "properties": {
    "sid": {
      "description": "Active Directory SID",
      "type": "string"
    },
    "name": {
      "description": "Name of the security principal",
      "type": "string"
    },
    "description": {
      "description": "A longer description of the security principal",
      "type": "string"
    }
  }
}
