{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "api_key addition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expires_in_seconds"
  ],
  "properties": {
    "expires_in_seconds": {
      "description": "Validity of the api_key, in seconds",
      "oneOf": [
        {
          "type": [
            "string"
          ],
          "enum": [
            "default"
          ]
        },
        {
          "type": "integer",
          "minimum": -1,
          "maximum": 2147483647
        }
      ]
    }
  }
}
