{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "name",
    "permissions",
    "api_key"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "description": "Name of the service_account",
      "type": "string"
    },
    "description": {
      "description": "The description of the service_account",
      "type": "string"
    },
    "access_restriction": {
      "description": "Access restriction assigned to the keys created under this service_account",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "description": "Access restriction URI",
          "type": "string"
        }
      }
    },
    "permissions": {
      "type": "array",
      "description": "The list of permissions",
      "items": {
        "description": "Permission granted",
        "type": "object",
        "required": [
          "role",
          "scope"
        ],
        "properties": {
          "role": {
            "$ref": "../common/orgs_roles.schema.json"
          },
          "scope": {
            "$ref": "org_scope.schema.json"
          }
        }
      }
    },
    "api_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expires_in_seconds"
      ],
      "properties": {
        "expires_in_seconds": {
          "description": "Validity of the api_key, in seconds",
          "oneOf": [
            {
              "type": [
                "string"
              ],
              "enum": [
                "default"
              ]
            },
            {
              "type": "integer",
              "minimum": -1,
              "maximum": 2147483647
            }
          ]
        }
      }
    }
  }
}
