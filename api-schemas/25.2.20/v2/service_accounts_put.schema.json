{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "description": "Service account name",
      "type": "string"
    },
    "description": {
      "description": "Description of the service_account",
      "type": "string"
    },
    "access_restriction": {
      "description": "Access restriction assigned to the keys created under this service_account",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "description": "Access restriction URI",
          "type": "string"
        }
      }
    },
    "permissions": {
      "type": "array",
      "description": "List of permissions",
      "items": {
        "description": "Permission granted",
        "type": "object",
        "required": [
          "role",
          "scope"
        ],
        "properties": {
          "href": {
            "description": "URI of the permission entity",
            "type": "string"
          },
          "role": {
            "$ref": "../common/orgs_roles.schema.json"
          },
          "scope": {
            "$ref": "org_scope.schema.json"
          }
        }
      }
    }
  }
}
