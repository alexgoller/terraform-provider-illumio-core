{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Org-based event setting",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "audit_event_retention_seconds": {
      "description": "The time in seconds an audit event is stored in the database",
      "type": "integer",
      "minimum": 86400,
      "maximum": 17280000
    },
    "audit_event_min_severity": {
      "$ref": "audit_event_min_severity.schema.json"
    },
    "format": {
      "description": "The log format (JSON, CEF, LEEF), which applies to all syslog destinations",
      "type": "string",
      "enum": [
        "JSON",
        "CEF",
        "LEEF"
      ]
    }
  }
}
