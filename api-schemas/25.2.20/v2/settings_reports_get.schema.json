{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "href": {
      "description": "Report Setting URI",
      "type": "string",
      "format": "uri"
    },
    "max_queued_reports": {
      "description": "maximum number of queued reports at anytime per org",
      "type": "integer",
      "maximum": 25
    },
    "report_retention_days": {
      "description": "Number of days a report would be retained for",
      "type": "integer",
      "default": 1,
      "minimum": 1,
      "maximum": 7
    }
  }
}
