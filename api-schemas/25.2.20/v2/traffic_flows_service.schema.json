{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "description": "Port, protocol, process, service name and user_name for a traffic flow",
  "required": [
    "port",
    "proto"
  ],
  "additionalProperties": false,
  "properties": {
    "port": {
      "description": "Destination port",
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "proto": {
      "description": "IANA protocol number",
      "type": "integer"
    },
    "process_name": {
      "description": "Process Name for this flow",
      "type": "string"
    },
    "windows_service_name": {
      "description": "Windows Service Name for this flow",
      "type": "string"
    },
    "user_name": {
      "description": "User Name for this flow",
      "type": "string"
    }
  }
}
