{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "rule_set_scope_get.schema.json",
  "description": "Rule set scope",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "exclusion": {
        "description": "Boolean to specify whether or not the scope is an exclusion",
        "type": "boolean",
        "expose_to": ["end_user_experimental"],
        "default": false
      },
      "label": { "$ref": "label_optional_key_value.schema.json" },
      "label_group": { "$ref": "label_group_optional_key_value.schema.json" }
    }
  }
}