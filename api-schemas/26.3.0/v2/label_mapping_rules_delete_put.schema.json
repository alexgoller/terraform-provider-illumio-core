{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rules"
  ],
  "properties": {
    "rules": {
      "description": "Rules to delete",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "href"
        ],
        "properties": {
          "href": {
            "description": "URI of label mapping rule to delete",
            "type": "string"
          }
        }
      },
      "minItems": 1,
      "maxItems": 1000
    }
  }
}
