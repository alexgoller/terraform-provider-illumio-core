{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "description": "Enabled flag",
      "type": "boolean"
    },
    "expression": {
      "$ref": "label_mapping_rule_expression.schema.json"
    },
    "label_assignments": {
      "$ref": "label_mapping_rule_label_assignments.schema.json"
    },
    "overwrite": {
      "description": "if overwrite is set to true, then an existing label of the same dimension will be overwritten",
      "default": false,
      "type": "boolean"
    }
  }
}
