{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "href": {
      "description": "Job URI",
      "type": "string",
      "format": "uri"
    },
    "result": {
      "description": "Result download URI. Available only if the job status is completed",
      "type": "string",
      "format": "uri"
    },
    "status": {
      "description": "Current job status",
      "type": "string"
    },
    "progress_percent": {
      "description": "Progress Percentage of the job",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "created_at": {
      "description": "Timestamp in UTC when this job was created",
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "object",
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "description": "User who created this run",
          "type": "string",
          "format": "uri"
        }
      }
    },
    "updated_at": {
      "description": "Timestamp in UTC when this job was updated",
      "type": "string",
      "format": "date-time"
    },
    "label_mapping_params": {
      "$ref": "label_mapping_rules_run_post.schema.json"
    }
  }
}
