{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "href"
    ],
    "properties": {
      "href": {
        "type": "string",
        "description": "href of the rule; required for bulk updates"
      },
      "enabled": {
        "description": "Enabled flag",
        "type": "boolean"
      },
      "expression": {
        "$ref": "label_mapping_rule_expression.schema.json"
      },
      "label_assignments": {
        "$ref": "label_mapping_rule_label_assignments.schema.json"
      }
    }
  }
}
