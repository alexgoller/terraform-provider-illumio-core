{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "$ref": "network_endpoint_config.schema.json",
      "required": [
        "endpoint_type",
        "name"
      ]
    },
    "workloads": {
      "description": "List of managed workloads",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "href"
        ],
        "properties": {
          "href": {
            "description": "URI of workload",
            "type": "string"
          }
        }
      }
    }
  }
}
