  "description": "The details of the permission to edit",
  "type": "object",
  "anyOf": [
    {
      "required": [
        "role"
      ]
    },
    {
      "required": [
        "scope"
      ]
    },
    {
      "required": [
        "auth_security_principal"
      ]
    }
  ],
  "properties": {
    "role": {
      "$ref": "../common/orgs_roles.schema.json"
    },
    "scope": {
      "$ref": "org_scope.schema.json"
    },
    "auth_security_principal": {
      "$ref": "auth_security_principal_uri.schema.json"
    }
  }
}
