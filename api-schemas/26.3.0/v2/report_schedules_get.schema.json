{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "href",
    "report_template",
    "name",
    "report_generation_frequency",
    "report_parameters"
  ],
  "properties": {
    "href": {
      "description": "Report Schedule URI",
      "type": "string",
      "format": "uri"
    },
    "report_template": {
      "description": "Template for the report",
      "type": "object",
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "description": "Report Template URI",
          "type": "string",
          "format": "uri"
        },
        "name": {
          "description": "Name of the report template",
          "type": "string"
        }
      }
    },
    "name": {
      "description": "Name of the report schedule",
      "type": "string",
      "maxLength": 255
    },
    "report_generation_frequency": {
      "description": "Report generation frequency",
      "type": "string"
    },
    "scheduled_at": {
      "description": "Timestamp in UTC for report generation",
      "type": "string",
      "format": "date-time"
    },
    "send_by_email": {
      "description": "Flag for whether to send user report by email",
      "type": "boolean"
    },
    "report_parameters": {
      "description": "Any specific parameters required for this report template",
      "type": "object",
      "anyOf": [
        {
          "$ref": "executive_summary_report_params.schema.json"
        },
        {
          "$ref": "traffic_flow_report_params.schema.json"
        },
        {
          "$ref": "explorer_report_params.schema.json"
        },
        {
          "$ref": "ves_report_params.schema.json"
        },
        {
          "$ref": "rule_hit_count_report_params.schema.json"
        },
        {
          "$ref": "ransomware_risk_report_params.schema.json"
        }
      ]
    },
    "created_at": {
      "description": "Timestamp (rfc3339 timestamp) in UTC when this report schedule was created",
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "object",
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "description": "The URI of the user who created this report schedule",
          "type": "string",
          "format": "uri"
        }
      }
    },
    "updated_at": {
      "type": "string",
      "description": "Timestamp (rfc3339 timestamp) when this report schedule was last updated.",
      "format": "date-time"
    },
    "updated_by": {
      "type": "object",
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "description": "The URI of the user who updated this report schedule",
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
