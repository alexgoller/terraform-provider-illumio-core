{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Services and ports used in the Rule",
  "type": "array",
  "minItems": 1,
  "items": {
    "oneOf": [
      {
        "type": "object",
        "required": [
          "href"
        ],
        "additionalProperties": false,
        "properties": {
          "href": {
            "description": "URI of the service",
            "type": "string"
          }
        }
      },
      {
        "$ref": "../common/windows_service_v2.schema.json"
      }
    ]
  }
}
