{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "name",
    "href",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "permissions",
    "api_keys"
  ],
  "properties": {
    "name": {
      "description": "Service account name",
      "type": "string"
    },
    "description": {
      "description": "Description of the service_account",
      "type": "string"
    },
    "access_restriction": {
      "description": "Access restriction assigned to the api_keys under this service_account",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "description": "Access restriction URI",
          "type": "string"
        }
      }
    },
    "permissions": {
      "type": "array",
      "description": "List of permissions",
      "items": {
        "description": "Permission granted",
        "type": "object",
        "required": [
          "role",
          "scope"
        ],
        "properties": {
          "href": {
            "description": "URI of the permission entity",
            "type": "string"
          },
          "role": {
            "$ref": "../common/orgs_roles.schema.json"
          },
          "scope": {
            "$ref": "org_scope.schema.json"
          }
        }
      }
    },
    "href": {
      "description": "URI of service_account",
      "type": "string"
    },
    "api_keys": {
      "type": "array",
      "description": "List of associated api_keys",
      "items": {
        "$ref": "api_keys_get.schema.json"
      }
    },
    "created_at": {
      "description": "Timestamp when this service account was first created (RFC 3339)",
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "description": "Timestamp when this service account was last updated",
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "object",
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "description": "User who originally created this service account",
          "type": "string"
        }
      }
    },
    "updated_by": {
      "type": "object",
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "description": "User who last updated this service account",
          "type": "string"
        }
      }
    }
  }
}
