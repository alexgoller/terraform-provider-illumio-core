{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "device_type": {
        "description": "Type of network device",
        "type": "string"
      },
      "manufacturers": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "manufacturer": {
              "description": "Device manufacturer",
              "type": "string"
            },
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "model"
                ],
                "properties": {
                  "model": {
                    "description": "Device model",
                    "type": "string"
                  },
                  "endpoint_type": {
                    "description": "Type of supported endpoint",
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
