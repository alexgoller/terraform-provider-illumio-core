{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Update a VEN's name, description, or target PCE.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target_pce_fqdn": {
      "description": "cluster FQDN for target PCE",
      "type": "string"
    },
    "name": {
      "description": "Friendly name of the VEN",
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "description": "Description of the VEN",
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "description": "VEN Status",
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ]
    },
    "golden_image": {
      "description": "Indicates whether this VEN is a golden image",
      "type": "boolean"
    }
  }
}
