{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vens"
  ],
  "properties": {
    "vens": {
      "description": "VENs to unpair",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "href"
        ],
        "properties": {
          "href": {
            "description": "URI of VEN to unpair",
            "type": "string"
          }
        }
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "firewall_restore": {
      "description": "The strategy to use to restore the firewall state after the VEN is uninstalled.",
      "type": "string",
      "enum": [
        "saved",
        "default",
        "disable"
      ],
      "default": "default"
    }
  }
}
