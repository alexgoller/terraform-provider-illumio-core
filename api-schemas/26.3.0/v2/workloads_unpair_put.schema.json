{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workloads"
  ],
  "properties": {
    "workloads": {
      "description": "Workloads to update",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "href"
        ],
        "properties": {
          "href": {
            "description": "URI of workload to update",
            "type": "string"
          }
        }
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "ip_table_restore": {
      "description": "The desired state of IP tables after the agent is uninstalled.",
      "type": "string",
      "enum": [
        "saved",
        "default",
        "disable"
      ],
      "default": "default"
    }
  }
}
